from flask import Flask

app = Flask(__name__)

@app.route("/")
def home():
    return """
<!DOCTYPE html>
<html>
<head>
<title>BBB Gaming Launcher</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    min-height: 100%;
    background:
        radial-gradient(circle at top center, rgba(125,249,255,.18), transparent 35%),
        linear-gradient(135deg, #071018, #0b1118 35%, #111827);
    color: #e8f8ff;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    background:
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
}

.shell {
    width: min(1500px, 94vw);
    margin: 30px auto;
    min-height: calc(100vh - 60px);
    border: 1px solid rgba(200,240,255,.28);
    border-radius: 32px;
    padding: 30px;
    background: rgba(13, 24, 34, .45);
    box-shadow:
        inset 0 0 70px rgba(255,255,255,.06),
        0 0 60px rgba(0,255,255,.08);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.menu {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(200,240,255,.35);
    display: grid;
    place-items: center;
    background: rgba(0,0,0,.28);
    box-shadow: inset 0 0 20px rgba(255,255,255,.06);
}

.menu span {
    width: 26px;
    height: 2px;
    background: #b8eaff;
    display: block;
    box-shadow: 0 8px 0 #b8eaff, 0 -8px 0 #b8eaff;
}

.status {
    display: flex;
    gap: 18px;
    font-size: 13px;
    opacity: .85;
}

.status b {
    color: #89ff7a;
}

.hero {
    text-align: center;
    margin-top: 6px;
}

.hero h1 {
    margin: 0;
    font-size: clamp(36px, 7vw, 78px);
    letter-spacing: .16em;
    font-weight: 900;
    color: transparent;
    background: linear-gradient(#f4fbff, #7d91a7 45%, #d8f8ff 55%, #334155);
    -webkit-background-clip: text;
    background-clip: text;
    text-shadow: 0 0 28px rgba(180,235,255,.22);
}

.hero p {
    margin: 8px 0 26px;
    letter-spacing: .45em;
    font-size: clamp(10px, 2vw, 15px);
    color: rgba(220,245,255,.58);
    text-transform: uppercase;
}

.layout {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 420px) 1fr;
    gap: 32px;
    align-items: center;
}

.side {
    display: grid;
    gap: 22px;
}

.card {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 105px;
    padding: 18px 22px;
    border-radius: 18px;
    border: 1px solid rgba(190,235,255,.34);
    background:
        linear-gradient(135deg, rgba(8,18,28,.86), rgba(3,8,14,.68));
    box-shadow:
        inset 0 0 28px rgba(255,255,255,.045),
        0 0 20px rgba(0,255,255,.055);
    text-decoration: none;
    color: #eaf9ff;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.card:hover {
    transform: translateY(-3px);
    border-color: rgba(125,249,255,.85);
    box-shadow:
        inset 0 0 32px rgba(255,255,255,.06),
        0 0 28px rgba(0,255,255,.18);
}

.icon {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    box-shadow: 0 0 22px currentColor;
    font-weight: 900;
    flex: 0 0 auto;
}

.cyan { color: #21d4ff; }
.pink { color: #ff3f8e; }
.yellow { color: #ffe600; }
.green { color: #70ff42; }
.blue { color: #2aa8ff; }
.purple { color: #c084fc; }

.card h2 {
    margin: 0 0 6px;
    font-size: 18px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.card p {
    margin: 0;
    font-size: 13px;
    color: rgba(225,245,255,.58);
    line-height: 1.35;
}

.arrow {
    margin-left: auto;
    font-size: 34px;
    color: currentColor;
}

.centerpiece {
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    position: relative;
    background:
        radial-gradient(circle at 35% 25%, rgba(255,255,255,.42), transparent 25%),
        radial-gradient(circle at 50% 55%, rgba(255,255,255,.13), rgba(255,255,255,.02) 58%, rgba(0,0,0,.18));
    border: 2px solid rgba(230,250,255,.45);
    box-shadow:
        inset 0 0 60px rgba(255,255,255,.16),
        inset 0 -20px 80px rgba(0,0,0,.35),
        0 0 42px rgba(125,249,255,.2);
    overflow: hidden;
}

.centerpiece::before {
    content: "";
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.28);
    box-shadow: inset 0 0 40px rgba(255,255,255,.08);
}

.centerpiece::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(115deg, transparent 0 38%, rgba(255,255,255,.22) 45%, transparent 54%),
        linear-gradient(180deg, rgba(255,255,255,.12), transparent 45%, rgba(255,255,255,.05));
    opacity: .55;
}

.logo {
    position: relative;
    z-index: 2;
    font-family: "Georgia", "Times New Roman", serif;
    font-size: clamp(76px, 12vw, 150px);
    font-weight: 900;
    letter-spacing: -.06em;
    color: rgba(210,235,245,.20);
    text-shadow:
        1px 1px 1px rgba(255,255,255,.75),
        -1px -1px 1px rgba(0,0,0,.8),
        0 0 18px rgba(255,255,255,.18);
    -webkit-text-stroke: 1px rgba(235,250,255,.52);
    filter: drop-shadow(0 8px 10px rgba(0,0,0,.65));
}

.stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-top: 28px;
}

.stat {
    min-height: 90px;
    border-radius: 16px;
    padding: 16px;
    border: 1px solid rgba(190,235,255,.25);
    background: rgba(5,13,20,.72);
    box-shadow: inset 0 0 24px rgba(255,255,255,.04);
}

.stat strong {
    display: block;
    color: #7df9ff;
    margin-bottom: 8px;
    text-transform: uppercase;
    font-size: 13px;
}

.stat span {
    color: rgba(235,250,255,.62);
    font-size: 13px;
}

.nav {
    margin: 28px auto 0;
    max-width: 1220px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid rgba(190,235,255,.25);
    border-radius: 22px;
    overflow: hidden;
    background: rgba(3,8,14,.7);
}

.nav a {
    padding: 18px 10px;
    text-align: center;
    color: rgba(240,250,255,.65);
    text-decoration: none;
    border-right: 1px solid rgba(190,235,255,.14);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.nav a:last-child {
    border-right: none;
}

.nav a:hover {
    color: #7df9ff;
    background: rgba(125,249,255,.08);
}

.footer {
    text-align: center;
    margin-top: 20px;
    font-size: 11px;
    letter-spacing: .22em;
    color: rgba(225,245,255,.25);
    text-transform: uppercase;
}

@media (max-width: 920px) {
    .shell {
        width: 96vw;
        padding: 18px;
        border-radius: 24px;
        margin: 12px auto;
    }

    .layout {
        grid-template-columns: 1fr;
    }

    .centerpiece {
        width: min(78vw, 360px);
        margin: 0 auto;
        order: -1;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .nav {
        grid-template-columns: 1fr 1fr;
    }

    .hero h1 {
        letter-spacing: .08em;
    }

    .hero p {
        letter-spacing: .18em;
    }

    .status {
        display: none;
    }
}
</style>
</head>

<body>
<div class="shell">

    <div class="topbar">
        <div class="menu"><span></span></div>
        <div class="status">
            <span><b>●</b> SYSTEM ONLINE</span>
            <span>BBB NODE READY</span>
            <span>RTX ACTIVE</span>
        </div>
    </div>

    <section class="hero">
        <h1>BBB GAMING</h1>
        <p>AI Enhanced Gaming Infrastructure</p>
    </section>

    <main class="layout">

        <section class="side">
            <a class="card cyan" href="http://192.168.0.102:5090">
                <div class="icon">AI</div>
                <div>
                    <h2>AI Spectator</h2>
                    <p>Live gameplay vision and commentary analysis.</p>
                </div>
                <div class="arrow">›</div>
            </a>

            <a class="card pink" href="http://192.168.0.102:5092">
                <div class="icon">HQ</div>
                <div>
                    <h2>Highlight Queue</h2>
                    <p>Detected gameplay moments and content candidates.</p>
                </div>
                <div class="arrow">›</div>
            </a>

            <a class="card yellow" href="http://192.168.0.102:5093">
                <div class="icon">RP</div>
                <div>
                    <h2>Highlight Report</h2>
                    <p>Ranked session notes, hype scores, and recaps.</p>
                </div>
                <div class="arrow">›</div>
            </a>
        </section>

        <section class="centerpiece">
            <div class="logo">BBB</div>
        </section>

        <section class="side">
            <a class="card green" href="http://192.168.0.101:3000">
                <div class="icon">AI</div>
                <div>
                    <h2>BBB AI Portal</h2>
                    <p>Open WebUI for local private AI access.</p>
                </div>
                <div class="arrow">›</div>
            </a>

            <a class="card blue" href="http://192.168.0.102:5091">
                <div class="icon">SM</div>
                <div>
                    <h2>Session Summary</h2>
                    <p>AI generated stream recaps and creator notes.</p>
                </div>
                <div class="arrow">›</div>
            </a>

            <a class="card purple" href="https://192.168.0.101:9443">
                <div class="icon">OP</div>
                <div>
                    <h2>Operations</h2>
                    <p>Infrastructure control through Portainer.</p>
                </div>
                <div class="arrow">›</div>
            </a>
        </section>

    </main>

    <section class="stats">
        <div class="stat"><strong>GPU</strong><span>RTX 6000 Blackwell</span></div>
        <div class="stat"><strong>Mode</strong><span>Local AI Stack</span></div>
        <div class="stat"><strong>Vision</strong><span>Spectator Ready</span></div>
        <div class="stat"><strong>Voice</strong><span>Companion Ready</span></div>
        <div class="stat"><strong>Pipeline</strong><span>Creator Automation</span></div>
    </section>

    <nav class="nav">
        <a href="http://192.168.0.102:5090">Spectator</a>
        <a href="http://192.168.0.102:5091">Summary</a>
        <a href="http://192.168.0.102:5092">Highlights</a>
        <a href="http://192.168.0.102:5093">Reports</a>
        <a href="http://192.168.0.101:3000">AI Portal</a>
        <a href="https://192.168.0.101:9443">Ops</a>
    </nav>

    <div class="footer">Big Brain Brand • Local First AI Gaming Platform</div>

<100)	
